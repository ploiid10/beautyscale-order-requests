# Optional. docker compose up works without this file.
# Copy to .env only to override the defaults.

POSTGRES_USER=orders
POSTGRES_PASSWORD=orders
POSTGRES_DB=orders
POSTGRES_PORT=5432

API_PORT=8080
WEB_PORT=5173

# Used by `go run` from api/. Compose sets its own URL for the api container.
DATABASE_URL=postgres://orders:orders@localhost:5432/orders?sslmode=disable
HTTP_ADDR=:8080
MIGRATIONS_DIR=migrations
SEED_FILE=seed/seed.sql
SEED=true
